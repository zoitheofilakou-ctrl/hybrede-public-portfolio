# HyBreDe - example environment file.
# Copy to `.env` and fill in real values. `.env` is git-ignored and must never
# be committed. No real credential is present anywhere in this repository.

# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# Required only when running the pipeline with `--provider openai` (the default
# in the Streamlit app). Used by llm/interface.py and screening/llm_screening.py.
OPENAI_API_KEY=your_openai_key_here

# Local Ollama alternative. No key required; the model must already be pulled.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=180

# ---------------------------------------------------------------------------
# Corpus acquisition (optional)
# ---------------------------------------------------------------------------
# Required only by data_acquisition/scraper.py, which raises at import time when
# this is unset. The Streamlit app defers that import so the evidence pipeline
# still starts without it.
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_key_here

# ---------------------------------------------------------------------------
# Data and runtime locations  (public-release configuration)
# ---------------------------------------------------------------------------
# The frozen research corpus and evidence store are NOT distributed with this
# repository. Point these at your own; both default to a repository-relative
# directory when unset, so nothing depends on any author's machine.
#
# Corpus / metadata root. Expected layout below it:
#   hybrede_metadata_v5.json
#   fulltext/<paperId>.txt
#   processed/filtered_papers.json
#   processed/corpus_source_manifest_v3.json
HYBREDE_DATA_DIR=./data
#
# Evidence store root: Chroma persistence plus lexical_index.json.
# Build one with `python Retrieval/retrieval.py index`.
HYBREDE_RAG_STORE_DIR=./rag_store

# ---------------------------------------------------------------------------
# Model cache (optional)
# ---------------------------------------------------------------------------
# Retrieval loads all-MiniLM-L6-v2 and cross-encoder/ms-marco-MiniLM-L-6-v2 with
# local_files_only=True, so both must already be present in the Hugging Face
# cache. Set HF_HOME to choose where that cache lives; leave unset to use the
# platform default. This repository hardcodes no cache path.
# HF_HOME=./.hf_cache
